# Praktikum 3 (BAB 3) — aturan IDS lokal (Suricata)
#
# Aturan ini SENGAJA dibuat agar benar-benar memicu pada lalu lintas
# laboratorium Anda sendiri, bukan sekadar berkas konfigurasi yang tersimpan.
#
# Cara pakai (lihat periksa_ids.sh):
#   suricata -i <antarmuka-bridge-lab> -S /etc/suricata/rules/suricata_local.rules
#
# Lingkup: aturan ini hanya dipasang pada antarmuka bridge laboratorium,
# sehingga lalu lintas rumah/kampus Anda tidak ikut dianalisis.
#
# SID 1000001-1000005 disediakan dosen sebagai titik awal.
# TUGAS ANDA (Langkah 6): perketat aturan ini dan tambahkan minimal satu
# aturan Anda sendiri yang benar-benar memicu. Simpan bukti alert-nya.

# ---------------------------------------------------------------------------
# 1. Pemindaian port — banyak SYN ke banyak tujuan dalam waktu singkat.
#    Memicu pada `nmap -sS -p- <subnet-lab>`.
# ---------------------------------------------------------------------------
alert tcp any any -> any any (msg:"LAB3 Pemindaian port terdeteksi (SYN masif)"; \
  flags:S; threshold: type threshold, track by_src, count 15, seconds 3; \
  classtype:attempted-recon; sid:1000001; rev:1;)

# ---------------------------------------------------------------------------
# 2. Nmap Scripting Engine (NSE) — dikenali dari User-Agent khasnya.
#    Memicu pada `nmap -sV -sC <subnet-lab>`.
# ---------------------------------------------------------------------------
alert http any any -> any any (msg:"LAB3 Nmap Scripting Engine (NSE) terdeteksi"; \
  http.user_agent; content:"Nmap Scripting Engine"; nocase; \
  classtype:attempted-recon; sid:1000002; rev:1;)

# ---------------------------------------------------------------------------
# 3. Probe HTTP gaya nmap — HTTP/1.0 tanpa User-Agent yang wajar.
#    Catatan sintaks: tanda titik koma di dalam nilai `content` WAJIB ditulis
#    sebagai `\;`, jika tidak Suricata akan menolak seluruh baris aturan.
#    Kesalahan ini sengaja dibiarkan sebagai bahan belajar: periksa
#    `docker logs <ids>` dan pastikan tidak ada baris "E: detect: error parsing".
# ---------------------------------------------------------------------------
alert http any any -> any any (msg:"LAB3 Probe HTTP tanpa User-Agent (nmap)"; \
  http.user_agent; content:"Mozilla/5.0 (compatible\; Nmap"; nocase; \
  classtype:attempted-recon; sid:1000003; rev:1;)

# ---------------------------------------------------------------------------
# 4. Koneksi ke PostgreSQL. Awalnya luas (semua sumber) — itulah titik mulai
#    yang harus Anda PERKETAT pada Langkah 6 sehingga hanya zona aplikasi
#    yang diizinkan. Perhatikan bahwa aturan ini juga memicu pada koneksi sah
#    dari `app`; gunakan itu sebagai alasan mengapa aturan perlu dirapikan.
# ---------------------------------------------------------------------------
alert tcp any any -> any 5432 (msg:"LAB3 Koneksi ke PostgreSQL terdeteksi"; \
  flags:S; threshold: type limit, track by_src, count 1, seconds 30; \
  classtype:policy-violation; sid:1000004; rev:1;)

# ---------------------------------------------------------------------------
# 5. Percobaan koneksi berulang — indikasi brute force atau pengintaian.
# ---------------------------------------------------------------------------
alert tcp any any -> any any (msg:"LAB3 Percobaan koneksi berulang (indikasi brute force)"; \
  flags:S; threshold: type threshold, track by_src, count 40, seconds 10; \
  classtype:attempted-dos; sid:1000005; rev:1;)

# ---------------------------------------------------------------------------
# TAMBAHKAN ATURAN ANDA SENDIRI DI BAWAH INI (Langkah 6).
# Gunakan SID 1000100 ke atas agar tidak bertabrakan dengan aturan dosen.
# ---------------------------------------------------------------------------
# alert tcp any any -> any 8080 (msg:"LAB3 Aturan saya: ..."; flags:S; \
#   classtype:policy-violation; sid:1000100; rev:1;)
